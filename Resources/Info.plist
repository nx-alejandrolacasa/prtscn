<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>PrtScn</string>
	<key>CFBundleDisplayName</key>
	<string>PrtScn</string>
	<key>CFBundleIdentifier</key>
	<string>com.alejandrolacasa.prtscn</string>
	<key>CFBundleExecutable</key>
	<string>PrtScn</string>
	<!-- CFBundleIconFile is the flat AppIcon.icns; CFBundleIconName additionally
	     points macOS 26 at the layered icon actool compiles from
	     Resources/AppIcon.icon into Assets.car. build.sh removes
	     CFBundleIconName when actool isn't available to compile it. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholders — build.sh stamps the real version (its VERSION variable)
	     and build number (git commit count) into the bundled copy. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Menu-bar app: no Dock icon, no app menu. Mirrors the accessory
	     activation policy also set in code in AppDelegate. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Alejandro G. Lacasa. All rights reserved.</string>
</dict>
</plist>
