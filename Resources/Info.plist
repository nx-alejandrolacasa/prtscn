<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>PrtScn</string>
	<key>CFBundleDisplayName</key>
	<string>PrtScn</string>
	<key>CFBundleIdentifier</key>
	<string>com.alejandrolacasa.prtscn</string>
	<key>CFBundleExecutable</key>
	<string>PrtScn</string>
	<!-- CFBundleIconFile is the flat AppIcon.icns; CFBundleIconName additionally
	     points macOS 26 at the layered icon actool compiles from
	     Resources/AppIcon.icon into Assets.car. build.sh removes
	     CFBundleIconName when actool isn't available to compile it. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Placeholders — build.sh stamps the real version (its VERSION variable)
	     and build number (git commit count) into the bundled copy. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Menu-bar app: no Dock icon, no app menu. Mirrors the accessory
	     activation policy also set in code in AppDelegate. -->
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PrtScn Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.alejandrolacasa.prtscn.project</string>
			</array>
			<key>LSTypeIsPackage</key>
			<true/>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.alejandrolacasa.prtscn.project</string>
			<key>UTTypeDescription</key>
			<string>PrtScn Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>prtscn</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Alejandro G. Lacasa. All rights reserved.</string>
</dict>
</plist>
